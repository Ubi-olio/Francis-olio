<%- partial('_partial/header', {}, {cache: true}) %>
<div class="page-content" style="width:90%; max-width:none;">
  <div class="sankey-archive-container category-summary-grid">
    <% site.categories.filter(function(category) { return !category.parent; }).sort('name').each(function(category) { %>
      <section class="sankey-articles-section">
        <h3 class="articles-section-title">
          <span class="title-text"><%= category.name %></span>
          <span class="articles-count-badge"><%= category.posts.length %> 篇</span>
        </h3>
        <div class="sankey-articles-list" style="grid-template-columns:1fr;">
          <% category.posts.sort('-date').each(function(post) { %>
            <a href="<%- url_for(post.path) %>" class="sankey-article-card">
              <div class="article-card-header">
                <h4 class="article-card-title"><%= post.title %></h4>
              </div>
              <div class="article-card-footer">
                <span class="article-date"><%= date(post.date, 'YYYY-MM-DD') %></span>
                <div class="article-taxonomies">
                  <% post.tags.each(function(tag) { %>
                    <span class="article-badge tag-badge">#<%= tag.name %></span>
                  <% }); %>
                </div>
              </div>
            </a>
          <% }); %>
        </div>
      </section>
    <% }); %>
  </div>
</div>
<style>
.category-summary-grid { margin-top:1.5rem; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2rem; align-items:start; }
@media (max-width:700px) { .category-summary-grid { grid-template-columns:1fr; } }
</style>
